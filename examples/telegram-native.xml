<App Name="Uvelgram — Native Uvel UI" Width="1180" Height="760" Theme="Dark">
  <Import Package="uvel" As="global" />

  <UI>
    <View Background="#0B0F19">
      <Card Name="sidebar" X="18" Y="20" Width="320" Height="720" Background="#111827" BorderColor="#243044" CornerRadius="30" Padding="18">
        <Text X="18" Y="18" Width="250" Height="42" Text="Uvelgram" FontSize="30" Foreground="#FFFFFF" Align="left" />
        <Text X="18" Y="60" Width="260" Height="24" Text="Telegram-like native Uvel UI" FontSize="13" Foreground="#94A3B8" Align="left" />
        <Input Name="search" X="18" Y="98" Width="284" Height="44" Text="Search chats" Placeholder="Search chats" Background="#1F2937" BorderBrush="#334155" />
        <Divider X="18" Y="158" Width="284" Height="10" />
        <List Name="chats" X="18" Y="178" Width="284" Height="520" Background="#00000000" BorderColor="#00000000" Padding="0" Gap="8">
          <ListItem Text="Diyorbek  ·  Online" Background="#1F2937" />
          <ListItem Text="UFlow Team  ·  Design update" Background="#111827" />
          <ListItem Text="Uvel Engine  ·  Native runtime" Background="#111827" />
          <ListItem Text="Workspace  ·  Hot reload ready" Background="#111827" />
          <ListItem Text="Cloud  ·  API status" Background="#111827" />
        </List>
      </Card>

      <Card Name="chatPanel" X="358" Y="20" Width="802" Height="720" Background="#0F172A" BorderColor="#243044" CornerRadius="30" Padding="0">
        <Card Name="topbar" X="20" Y="20" Width="762" Height="76" Background="#111827" BorderColor="#243044" CornerRadius="24" Padding="14">
          <Text X="18" Y="10" Width="360" Height="32" Text="Diyorbek" FontSize="22" Foreground="#FFFFFF" Align="left" />
          <Text Name="status" X="18" Y="42" Width="520" Height="22" Text="Online · Uvel native UI is ready" FontSize="13" Foreground="#34C759" Align="left" />
          <Badge X="650" Y="22" Width="86" Height="28" Text="native" />
        </Card>

        <Scroll Name="messages" X="20" Y="112" Width="762" Height="420" Background="#0B1220" BorderColor="#00000000" CornerRadius="18" Padding="8" Gap="10">
          <ListItem Text="Hello! This is a Telegram-like Uvel native UI demo." Align="left" Background="#1E293B" />
          <ListItem Text="It is drawn by Uvel custom native renderer, not XAML." Align="left" Background="#1E293B" />
          <ListItem Text="Use the input below and press Send." Align="right" Background="#34C759" />
        </Scroll>

        <Card Name="composer" X="20" Y="552" Width="762" Height="146" Background="#111827" BorderColor="#243044" CornerRadius="24" Padding="0">
          <Input Name="messageInput" X="18" Y="18" Width="520" Height="46" Text="Assalomu alaykum, Uvel!" Placeholder="Write a message..." Background="#1F2937" BorderBrush="#334155" />
          <Button X="552" Y="18" Width="192" Height="46" Content="Send message" onClick="SendMessage" Background="#34C759" />
          <Button X="18" Y="82" Width="160" Height="42" Content="Save DB" onClick="uvel.database.save" Background="#1F2937" />
          <Button X="190" Y="82" Width="160" Height="42" Content="Load DB" onClick="uvel.database.load" Background="#1F2937" />
          <Button X="362" Y="82" Width="180" Height="42" Content="Backend ping" onClick="uvel.backend.ping" Background="#1F2937" />
        </Card>
      </Card>
    </View>
  </UI>

  <Logic>
    <Handler Name="SendMessage">
      <AddMessage Container="messages" Text="{messageInput.Text}" Sender="me" />
      <ClearText Control="messageInput" />
      <Set Target="status" Property="Text" Value="Message sent through Uvel native UI" />
    </Handler>
  </Logic>
</App>
